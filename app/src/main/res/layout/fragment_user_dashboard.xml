<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 🌟 Top Header with Logo + Title -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/top_header_gradient"
        android:paddingTop="32dp"
        android:paddingBottom="5dp"
        android:elevation="6dp"
        android:gravity="center">

        <!-- Header Title -->
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SahulatKaar"
            android:textColor="@color/Bluenew"
            android:textSize="30sp"
            android:fontFamily="@font/popins" />

        <!-- Divider Line -->
        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="#80FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_gravity="center" />
    </LinearLayout>

    <!-- ✅ Scrolling Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- ✅ Hero Section with Background Image + Fade -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp">

                <ImageView
                    android:id="@+id/heroBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/coverimage" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_gradient" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="80dp">

                    <TextView
                        android:id="@+id/welcomeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/popins"
                        android:text="Welcome to SahulatKaar"
                        android:textColor="@android:color/white"
                        android:shadowColor="#80000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/welcomeSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/popins"
                        android:text="Your personal assistant in Lahore"
                        android:textColor="@color/white"
                        android:textSize="16sp" />
                </LinearLayout>
            </RelativeLayout>


            <!-- ✅ Carousel Floating on Hero -->
            <androidx.cardview.widget.CardView
                android:id="@+id/carouselCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:padding="8dp">

                    <!-- Left Arrow -->
                    <ImageButton
                        android:id="@+id/leftArrow"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@android:color/white"
                        android:contentDescription="Previous" />

                    <!-- Right Arrow -->
                    <ImageButton
                        android:id="@+id/rightArrow"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@android:color/white"
                        android:contentDescription="Next" />

                    <!-- Carousel Dots -->
                    <LinearLayout
                        android:id="@+id/carouselDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="12dp"
                        android:gravity="center">

                        <View
                            android:id="@+id/dot1"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_selected"
                            android:layout_margin="4dp" />

                        <View
                            android:id="@+id/dot2"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_unselected"
                            android:layout_margin="4dp" />

                        <View
                            android:id="@+id/dot3"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_unselected"
                            android:layout_margin="4dp" />
                    </LinearLayout>

                    <!-- Swappable Middle Content -->
                    <FrameLayout
                        android:id="@+id/carousel_content_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/leftArrow"
                        android:layout_toStartOf="@id/rightArrow"
                        android:layout_above="@id/carouselDots"
                        android:layout_alignParentTop="true">

                        <!-- Card 1 -->
                        <LinearLayout
                            android:id="@+id/carouselCard1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="visible"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/cardTitle1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/popins"
                                android:text="Har sheher tak Sahulat"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cardDesc1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:text="Lahore, Multan, Faisalabad aur dusre Cities mein — aapka kaam, hamari zimmedari!"
                                android:textColor="@color/black"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Card 2 -->
                        <LinearLayout
                            android:id="@+id/carouselCard2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/cardTitle2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/popins"
                                android:text="Waqt bachaen, safar se bachain"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cardDesc2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:text="Bina travel kiye sab ho sakta hai — SahulatKaar par bharosa karein, aur sukoon se kaam karwaen!"
                                android:textColor="@color/black"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Card 3 -->
                        <LinearLayout
                            android:id="@+id/carouselCard3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/cardTitle3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/popins"
                                android:text="Aapka kaam, hamari zimmedari"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cardDesc3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:text="SahulatKaar karega aapka har kaam Lahore mein, bina aapko safar karaye"
                                android:textColor="@color/black"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/createTaskButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/popins"
                android:text="Create New Order"
                android:textColor="@color/Bluenew"
                android:textSize="18sp"
                app:backgroundTint="@color/btncolor" />

            <!-- Help Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:padding="16dp"
                    android:background="@drawable/userdahboardborder"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="Need Help? Contact Us"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppinssemibold"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center">

                        <LinearLayout
                            android:id="@+id/whatsappBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:gravity="center"
                            android:background="@drawable/helpbtnwhatsapp">

                            <TextView
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/popins"
                                android:gravity="center"
                                android:text="Order On \nWhatsApp"
                                android:textColor="@color/Bluenew"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="8dp"
                            android:layout_height="0dp" />

                        <LinearLayout
                            android:id="@+id/callBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:gravity="center"
                            android:background="@drawable/helpbtnwhatsapp">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/popins"
                                android:text="Order On \nCall"
                                android:textColor="@color/Bluenew"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- What can we do for you -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What can we do for you?"
                android:textColor="@color/black"
                android:fontFamily="@font/poppinssemibold"
                android:textSize="20sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <GridLayout
                android:id="@+id/serviceGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="true">

                <!-- Box 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/gift"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:orientation="vertical"
                        android:background="@drawable/border"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:tint="@color/iconcolor"
                            android:src="@drawable/giftbox" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gifts and \nSurprises"
                            android:fontFamily="@font/popins"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Box 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/shopping"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/border"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginBottom="10dp"
                            app:tint="@color/iconcolor"
                            android:src="@drawable/shop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shopping"
                            android:fontFamily="@font/popins"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Box 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/medicine"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:orientation="vertical"
                        android:background="@drawable/border"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginBottom="10dp"
                            app:tint="@color/iconcolor"
                            android:src="@drawable/medicine" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medicine"
                            android:fontFamily="@font/popins"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Box 4 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/personalvisit"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:orientation="vertical"
                        android:background="@drawable/border"
                        android:padding="16dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:tint="@color/iconcolor"
                            android:src="@drawable/personalviists" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Personal \nVisits"
                            android:fontFamily="@font/popins"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Box 5 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/doc"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:orientation="vertical"
                        android:background="@drawable/border"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginBottom="5dp"
                            app:tint="@color/iconcolor"
                            android:src="@drawable/doc" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Documents"
                            android:fontFamily="@font/popins"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Box 6 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:id="@+id/customreq"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/border"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:tint="@color/iconcolor"
                            android:src="@drawable/doc" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/popins"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:text="Any Other Work"
                            android:textSize="12sp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!-- Recent Tasks -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Tasks"
                    android:fontFamily="@font/poppinssemibold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/viewAllTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:fontFamily="@font/interregular"
                    android:textColor="#0080FF"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentTasksRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
