<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_header_gradient"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button_desc"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create New Order"
            android:textColor="@color/Bluenew"
            android:textSize="22sp"
            android:fontFamily="@font/poppinssemibold" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="#80FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_gravity="center" />
        </LinearLayout>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="16dp">

            <!-- Select Category Section -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Category"
                android:layout_marginTop="12dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold"
                />

            <!-- What do you need us to do? Section -->
            <GridLayout
                android:id="@+id/gridLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- Gift -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGift"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/gift"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/giftbox" />

                        <TextView
                            android:id="@+id/giftLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/interregular"
                            android:gravity="center"
                            android:text="Gifts"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Shopping -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShopping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/shopping"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/shop" />

                        <TextView
                            android:id="@+id/shoppingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/interregular"
                            android:gravity="center"
                            android:text="Shopping"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Medicine -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMedicine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/medicine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/medicine" />

                        <TextView
                            android:id="@+id/medicineLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/interregular"
                            android:gravity="center"
                            android:text="Medicine"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Personal Visit -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVisit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/personalvisit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/personalviists" />

                        <TextView
                            android:id="@+id/visitLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/interregular"
                            android:gravity="center"
                            android:text="Visit"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Documents -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDocuments"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/doc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/doc" />

                        <TextView
                            android:id="@+id/documentsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/interregular"
                            android:gravity="center"
                            android:text="Documents"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Custom -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCustom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/customreq"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/doc" />

                        <TextView
                            android:id="@+id/customLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/interregular"
                            android:gravity="center"
                            android:text="Custom"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="What do you need us to do?"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold" />

            <EditText
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/interregular"
                android:hint="e.g., Send birthday cake to my mom"
                android:padding="12dp"
                android:background="@drawable/edittext_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Phone Number"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold" />

            <EditText
                android:id="@+id/contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/interregular"
                android:hint="Enter Phone Number For Contact"
                android:padding="12dp"
                android:inputType="phone"
                android:background="@drawable/edittext_background" />

            <!-- Details & Instructions Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Details and Instructions"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold" />

            <EditText
                android:id="@+id/editdesc"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:fontFamily="@font/interregular"
                android:hint="Provide specific details, preferences, or special instructions..."
                android:padding="12dp"
                android:background="@drawable/edittext_background"
                android:inputType="textMultiLine" />

            <!-- Location in Lahore Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Location"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold" />

            <EditText
                android:id="@+id/editlocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/interregular"
                android:hint="e.g., DHA Phase 5, Gulberg, Model Town"
                android:padding="12dp"
                android:background="@drawable/edittext_background" />

            <!-- Urgency Level Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Urgency Level"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3"
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <!-- Low Urgency -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lowUrgency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/low"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/lowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppinssemibold" />

                        <TextView
                            android:id="@+id/lowTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="2 To 3 days"
                            android:fontFamily="@font/interregular"
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Normal Urgency -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/normalUrgency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/card_default"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/normal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/normalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Normal"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppinssemibold" />

                        <TextView
                            android:id="@+id/normalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="1 To 2 days"
                            android:fontFamily="@font/interregular"
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Urgent -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/urgentUrgency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/card_default"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borderline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/urgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/urgentLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Urgent"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppinssemibold" />

                        <TextView
                            android:id="@+id/urgentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="1 Day"
                            android:fontFamily="@font/interregular"
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pricing"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/poppinssemibold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp"
                android:background="@color/SkyDarkBlue"
                app:cardElevation="2dp"
                app:strokeColor="@color/grey"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#AAD5D1"
                    android:padding="16dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/interregular"
                        android:text="Task pricing will be discussed after submission."
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/interregular"
                        android:text="We'll contact you via WhatsApp or call to provide a fair quote based on your specific requirements."
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <Button
                android:id="@+id/submitTaskButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Submit Order"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/btncolor"
                android:textColor="@color/black" />


        </LinearLayout>
    </ScrollView>
</RelativeLayout>