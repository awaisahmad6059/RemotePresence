<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Static Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/top_header_gradient"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        android:elevation="6dp"
        android:gravity="center">

        <TextView
            android:id="@+id/allTasksTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Orders"
            android:fontFamily="@font/popins"
            android:textSize="22sp"
            android:textColor="@color/Bluenew"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="#80FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Custom Filter Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center">

            <!-- Pending Filter -->
            <LinearLayout
                android:id="@+id/pending_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/pending_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textSize="16sp"
                    android:textColor="@color/btncolor"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/pending_underline"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/btncolor"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- In Progress Filter -->
            <LinearLayout
                android:id="@+id/in_progress_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/in_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Progress"
                    android:textSize="16sp"
                    android:textColor="@android:color/darker_gray" />

                <View
                    android:id="@+id/in_progress_underline"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/btncolor"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- Completed Filter -->
            <LinearLayout
                android:id="@+id/completed_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/completed_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed"
                    android:textSize="16sp"
                    android:textColor="@android:color/darker_gray" />

                <View
                    android:id="@+id/completed_underline"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/btncolor"
                    android:visibility="invisible"/>
            </LinearLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allTasksRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

</RelativeLayout>